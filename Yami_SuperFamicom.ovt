@OBSThemeMeta {
    name: 'Super Famicom';
    id: 'com.obsproject.Yami.SuperFamicom';
    extends: 'com.obsproject.Yami';
    author: 'kjozk & Antigravity';
    dark: 'false';
}

@OBSThemeVars {
    /* Super Famicom Colors */
    --sfc_case: #e1e1e1;
    --sfc_mid: #707372;
    --sfc_dark: #6d766f;
    --sfc_red: #ee162f;    /* A Button */
    --sfc_yellow: #fed300; /* B Button */
    --sfc_green: #00a046;  /* Y Button */
    --sfc_blue: #0059a9;   /* X Button */

    /* Override Yami Variables for Contrast */
    --bg_window: var(--sfc_case);
    --bg_base: var(--sfc_case);
    --bg_preview: var(--sfc_dark);

    /* Text contrast maximization */
    --text: #050505;
    --text_light: #050505;
    --text_muted: #2a2a2a;
    --text_inactive: #404040;
    --text_disabled: var(--grey5);

    /* Palette overrides to prevent white text on light background */
    --palette_windowText: var(--text);
    --palette_text: var(--text);
    --palette_buttonText: var(--text);
    --palette_highlightedText: #ffffff; /* Selection text remains white */

    --primary: var(--sfc_blue);
    --primary_light: #205090;
    --primary_dark: #002050;

    --warning: var(--sfc_yellow);
    --danger: var(--sfc_red);
    --success: var(--sfc_green);

    --sfc_system: var(--sfc_dark);
    --sfc_system_hover: #7d867f;
    --sfc_system_pressed: #5d665f;

    /* Grey Palette Mapping (Used for depth and controls) */
    --grey1: #f0f0f0;
    --grey2: #e0e0e0;
    --grey3: #d0d0d0;
    --grey4: var(--sfc_case);
    --grey5: #999999;
    --grey6: var(--sfc_mid);
    --grey7: var(--sfc_dark);
    --grey8: #333333;

    /* Input/Button Visuals */
    --input_bg: #ffffff;
    --input_bg_hover: #f5f5f5;
    --input_bg_focus: #ffffff;
    --button_bg: var(--sfc_system);
    --button_bg_hover: var(--sfc_system_hover);
    --button_bg_down: var(--sfc_system_pressed);
    --button_bg_disabled: var(--sfc_mid);

    --border_color: var(--sfc_dark);
    --input_border: var(--sfc_dark);
    --input_border_focus: var(--primary);
    --button_border: var(--sfc_dark);
    --input_border_width: 1px;
    --button_border_width: 1px;
}

/* ドックのタイトルバーの背景を暗くして引き締める */
QDockWidget::title {
    background-color: var(--sfc_dark);
    color: #ffffff !important;
    padding: 4px;
}

/* ジオメトリ（矢印・ドロップダウン）の視認性改善 */
QComboBox::drop-down,
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: var(--sfc_mid);
    border-left: 1px solid var(--sfc_dark);
    width: 20px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/res/images/up.svg); }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/res/images/down.svg); }
QComboBox::down-arrow, QDateTimeEdit::down-arrow { image: url(:/res/images/collapse.svg); }

/* 音声ミキサーの調整：ベースを本体色に、ヘッダーを暗く */
#mixerContainer, #mixerArea {
    background-color: var(--sfc_case);
}

/* ミキサーのヘッダー部分 (Global, Active等) を暗くして引き締める */
#mixerContainer QWidget[header="true"] QLabel,
#mixerContainer QLabel#header,
#mixerContainer .header {
    background-color: var(--sfc_dark);
    color: #ffffff !important;
}

/* 選択・ハイライト時のテキスト色修正 (青背景での視認性確保) */
QAbstractItemView::item:selected,
QAbstractItemView::item:hover,
QMenuBar::item:selected,
QMenu::item:selected,
QTabBar::tab:selected,
SceneTree::item:selected,
SourceTree::item:selected,
QPushButton:checked,
QPushButton:pressed {
    color: #ffffff !important;
}

/* スライダー (QSlider) の視認性改善 - スーファミのスイッチ風のデザイン */
QSlider::groove:horizontal {
    background-color: var(--sfc_mid);
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: var(--sfc_system);
    border: 1px solid var(--sfc_dark);
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: var(--sfc_system_hover);
}

QSlider::groove:vertical {
    background-color: var(--sfc_mid);
    width: 4px;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: var(--sfc_system);
    border: 1px solid var(--sfc_dark);
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background-color: var(--sfc_system_hover);
}

/* リスト表示全体の選択時文字色を固定 */
QAbstractItemView {
    selection-background-color: var(--primary);
    selection-color: #ffffff;
}

/* メニューの選択時ハイライト色を明示 */
QMenu::item:selected,
QMenuBar::item:selected {
    background-color: var(--primary);
}

/* ダイアログとグループボックスの調整 */
QGroupBox {
    font-weight: bold;
    color: var(--sfc_dark);
    border: 1px solid var(--sfc_mid);
    border-radius: 4px;
    margin-top: 15px;
    padding: 10px;
}

QGroupBox::title {
    color: var(--sfc_dark);
    subcontrol-origin: margin;
    left: 10px;
}

/* 設定画面の左側リスト（サイドバー）の視認性向上 */
OBSBasicSettings QListWidget {
    background-color: #d8d8d8;
    border-right: 1px solid var(--sfc_mid);
}

OBSBasicSettings QListWidget::item {
    padding: 8px;
}

/* 設定画面下部のシステムボタン (OK, キャンセル, 適用) */
OBSBasicSettings QPushButton {
    background-color: var(--sfc_system);
    color: #ffffff !important;
    border: 1px solid var(--sfc_dark);
    min-width: 80px;
    padding: 4px 12px;
}

OBSBasicSettings QPushButton:hover {
    background-color: var(--sfc_system_hover);
}

OBSBasicSettings QPushButton:pressed {
    background-color: var(--sfc_system_pressed);
}

/* --- コントロールボタンのスタイル定義 --- */

/* 1. 基本的なボタン（設定・終了、ツールボタン等）を --sfc_system に統一 */
QPushButton,
QToolButton,
#settingsButton,
#exitButton {
    background-color: var(--sfc_system);
    color: #ffffff !important;
    border: 1px solid var(--sfc_case);
    padding: 4px;
}

QPushButton:disabled,
QToolButton:disabled {
    color: var(--text_disabled);
    border-color: #cccccc;
}


QPushButton:hover,
QToolButton:hover,
#settingsButton:hover,
#exitButton:hover {
    background-color: var(--sfc_system_hover);
}

QPushButton:pressed,
QToolButton:pressed,
#settingsButton:pressed,
#exitButton:pressed {
    background-color: var(--sfc_system_pressed);
}

/* 2. 個別ボタン（配信・録画・仮想カメラ・スタジオモード）の基本色 */
QPushButton#streamButton     { background-color: var(--sfc_red);    color: #ffffff !important; border: 1px solid var(--sfc_case); }
QPushButton#recordButton     { background-color: var(--sfc_yellow); color: #050505 !important; border: 1px solid var(--sfc_case); }
QPushButton#virtualCamButton { background-color: var(--sfc_blue);   color: #ffffff !important; border: 1px solid var(--sfc_case); }
QPushButton#modeSwitch       { background-color: var(--sfc_green);  color: #ffffff !important; border: 1px solid var(--sfc_case); }

/* 3. ホバー時の調整（少し明るく） */
QPushButton#streamButton:hover     { background-color: #e33b57; }
QPushButton#recordButton:hover     { background-color: #ffde40; }
QPushButton#virtualCamButton:hover { background-color: #2050b0; }
QPushButton#modeSwitch:hover       { background-color: #25a231; }

/* 4. アクティブ（実行中 / チェック状態）の色を濃い色に変更 */
/* より強力なセレクターを使用して確実に上書きする */
QPushButton#streamButton:checked,
QPushButton#streamButton:checked:enabled {
    background-color: #900000 !important;
    color: #ffffff !important;
}

QPushButton#recordButton:checked,
QPushButton#recordButton:checked:enabled {
    background-color: #b08000 !important;
    color: #ffffff !important;
}

QPushButton#virtualCamButton:checked,
QPushButton#virtualCamButton:checked:enabled {
    background-color: #002060 !important;
    color: #ffffff !important;
}

QPushButton#modeSwitch:checked,
QPushButton#modeSwitch:checked:enabled {
    background-color: #005020 !important;
    color: #ffffff !important;
}

/* 録画停止中（通常時）の文字色を黒に固定 */
QPushButton#recordButton:not(:checked) {
    color: #050505 !important;
}

