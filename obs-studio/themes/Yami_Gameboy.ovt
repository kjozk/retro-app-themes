@OBSThemeMeta {
    name: '[1989] GB - ゲームボーイ';
    id: 'com.obsproject.Yami.Gameboy';
    extends: 'com.obsproject.Yami.Light';
    author: 'kjozk & Antigravity';
    dark: 'false';
}

@OBSThemeVars {
    /* =========================================================================
       ゲームボーイ（Gameboy DMG-01）実機再現カラーパレット
       ========================================================================= */
    --gb_body: #e4e4de;         /* 本体オフホワイト成型色（ベース背景） */
    --gb_body_light: #ffffff;   /* 入力欄・通常ボタン背景 */
    --gb_body_dark: #d6d6ce;    /* リスト・サイドバー背景 */
    --gb_mid: #8a8e98;          /* スライダー溝 / 区切り線 */
    --gb_border: #b8b8b0;
    --gb_screen_bg: #8cad28;       /* コンポーネント境界線 */
    --gb_bezel: #686e7a;        /* 画面ベゼルのスレートグレー */
    --gb_bezel_light: #b4b8c2;  /* ベゼルの明るいグレー */

    /* --- GB 象徴的パーツカラー (実機写真準拠) --- */
    --gb_azuki: #8e1e4f;        /* A/B ボタン (小豆色 / Azuki Maroon) - 配信ボタン / OKボタン / ドックアクセント */
    --gb_azuki_hover: #a8255e;
    --gb_azuki_pressed: #73153d;
    --gb_azuki_glow: #d6337a;

    --gb_start_select: #9ca0aa; /* START / SELECT ボタン (ラバーグレー / Rubber Grey) */
    --gb_start_select_hover: #abafb8;
    --gb_start_select_pressed: #848892;
    --gb_start_select_border: #767a84;

    --gb_dial: #60646e;         /* 音量・コントラストダイヤル (Dial Slate Grey) */
    --gb_dial_hover: #727682;
    --gb_dial_pressed: #4c505a;

    --gb_indigo: #393c9f;       /* ロゴ・テキスト (青紫 / Indigo Violet) - 録画ボタン / フォーカス / 選択ハイライト */
    --gb_indigo_hover: #4a4eb8;
    --gb_indigo_pressed: #2a2d7d;
    --gb_indigo_glow: #7075e8;

    --gb_lcd: #8c9e5b;          /* 初代液晶オリーブグリーン (Olive LCD) - 仮想カメラ / レベルメーター */
    --gb_lcd_hover: #9bb066;
    --gb_lcd_pressed: #788a48;
    --gb_lcd_glow: #b2c974;

    --gb_black: #1c1e20;        /* 十字キー・ゴムボタン (Matte D-Pad Black) - スタジオモード */
    --gb_black_hover: #32353a;
    --gb_black_pressed: #101214;
    --gb_black_border: #4a4e58;

    --gb_battery: #d62222;      /* BATTERY LED (Red) - 警告 / エラー / 音量ピーク */

    /* --- 画面全体の背景定義 --- */
    --bg_window: var(--gb_body);
    --bg_base: var(--gb_body);
    --bg_preview: #58555e;      /* 実機画面ベゼルカバーのスレートグレー（画面周囲の樹脂カバー） */

    /* =========================================================================
       文字色・パレット設定（絶対に文字が背景に溶け込まないための完全定義）
       ========================================================================= */
    --text: #202458;            /* メインテキスト: 高コントラストな濃色 */
    --text_light: #ffffff;      /* 暗色ボタン・ヘッダー用ホワイト */
    --text_muted: #4a4e78;      /* 補足テキスト */
    --text_inactive: #303460;
    --text_disabled: #9ea4b0;   /* 無効時でも視認できるグレー */

    /* Qt パレット完全上書き (非QSSウィジェットの白文字化を防止) */
    --palette_windowText: #202458;
    --palette_text: #202458;
    --palette_buttonText: #202458;
    --palette_brightText: #ffffff;
    --palette_highlightedText: #ffffff;
    --palette_toolTipText: #ffffff;
    --palette_window: var(--gb_body);
    --palette_base: #ffffff;
    --palette_button: #ffffff;
    --palette_mid: var(--gb_border);

    --primary: var(--gb_azuki);
    --primary_light: var(--gb_azuki_hover);
    --primary_lighter: #ffffff;
    --primary_dark: var(--gb_azuki_pressed);
    --primary_darker: #3a0018;
    --highlight_color: #ffffff;
    --list_item_bg_selected: #b2c47e;
    --list_item_bg_hover: #d8dce6;
    --tab_border_focus: #ffffff;

    /* 基底テーマ(Yami/Light)の青色変数をGB用カラーで完全無力化 */
    --blue1: #ffffff;
    --blue2: var(--gb_indigo_hover);
    --blue3: var(--gb_indigo);
    --blue4: var(--gb_indigo_pressed);
    --blue5: var(--gb_indigo_pressed);
    --blue6: #1f215c;

    --warning: var(--gb_azuki);
    --danger: var(--gb_battery);

    /* 入力フォーム & 汎用ボタン変数 */
    --input_bg: #8cad28;         /* テトリスSTN液晶ベース黄緑 */
    --input_bg_hover: #9ec03e;   /* テトリスホバー */
    --input_bg_focus: #bce248;   /* テトリス確定フォーカス (オリーブゴールド) */
    --input_border: #6e923a;     /* 液晶枠線ボーダー */
    --input_border_focus: #214231; /* 最暗ドット枠線 */
    --input_text: #214231;       /* 最暗ドット前景色 */

    --button_bg: #ffffff;
    --button_bg_hover: #f2f2eb;
    --button_bg_down: #deded4;
    --button_bg_disabled: #e6e6dc;
    --button_border: var(--gb_border);
    --button_border_hover: var(--gb_indigo);
    --button_border_focus: var(--gb_azuki);
    --button_border_width: 1px;
}

/* =============================================================================
   1. 基本ウィジェット & 文字コントラスト保護
   ============================================================================= */

/* 全ウィジェットの基本テキスト色および標準フォント設定（OBS Default テーマスタック準拠） */
QWidget {
    color: var(--text);
    selection-background-color: #b2c47e;
    selection-color: #101a08;
    font-family: 'Open Sans', '.AppleSystemUIFont', Helvetica, Arial, 'MS Shell Dlg', sans-serif;
}

/* ラベル、チェックボックス、ラジオボタンの視認性確保 */
QLabel {
    color: var(--text);
}

QLabel:disabled {
    color: var(--text_disabled);
}

QCheckBox,
QRadioButton {
    color: var(--text);
    spacing: 6px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: var(--text_disabled);
}

/* =============================================================================
   2. ドック・タイトルバー・ウィンドウ枠
   ============================================================================= */

/* ドックタイトルバー: 初代ゲームボーイ A/Bボタンの小豆色（マルーン） */
QDockWidget {
    color: #ffffff;
    titlebar-close-icon: url(theme:Dark/close.svg);
    titlebar-normal-icon: url(theme:Dark/popout.svg);
}

QDockWidget::title {
    background-color: var(--gb_azuki);
    color: #ffffff !important;
    padding: 6px 10px;
    font-weight: bold;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

/* ドック内部のベースコンテナ */
OBSDock > QWidget {
    background: var(--gb_body);
    border: 1px solid var(--gb_border);
    border-top: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* ドックのタブバー（「ソース」「シーントランジション」「シーン」等）の視認性完全確保 */
QTabBar {
    outline: none;
}

QTabBar::tab {
    background: #d6d6ce;
    color: #383025 !important;
    border: 1px solid var(--gb_border);
    padding: var(--tab_padding_base) 6px;
    min-width: 40px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background: #f4f4ee;
    color: var(--gb_azuki) !important;
    border-color: var(--gb_indigo);
}

/* 選択タブ: 小豆色背景の上にクッキリと読める真っ白な太字 */
QTabBar::tab:selected {
    background: var(--gb_azuki) !important;
    color: #ffffff !important;
    border: 1px solid #7d0e16 !important;
    border-bottom: 2px solid var(--gb_indigo) !important;
    font-weight: bold;
}

/* ステータスバー（最下部） */
QStatusBar {
    background-color: var(--gb_body_dark);
    color: var(--text);
    border-top: 1px solid var(--gb_border);
}

QStatusBar QLabel {
    color: var(--text) !important;
}

/* メニューバー & メニュー */
QMenuBar {
    background-color: var(--gb_body);
    color: var(--text);
    border-bottom: 1px solid var(--gb_border);
}

QMenuBar::item {
    background: transparent;
    color: var(--text);
    padding: 5px 9px;
}

QMenuBar::item:selected {
    background-color: #b2c47e;
    color: #101a08 !important;
    border-radius: 3px;
}

QMenu {
    background-color: #ffffff;
    color: var(--text);
    border: 1px solid var(--gb_border);
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 3px;
    color: var(--text);
}

QMenu::item:selected {
    background-color: #b2c47e;
    color: #101a08 !important;
}

QMenu::separator {
    height: 1px;
    background-color: var(--gb_body_dark);
    margin: 4px 6px;
}

/* =============================================================================
   3. 一般ボタン (QPushButton, QToolButton)
   ============================================================================= */

/* ダイアログや設定画面内の通常ボタン: アイボリー調 + 青紫ホバー枠線 */
QPushButton,
QToolButton {
    background-color: var(--button_bg);
    color: var(--text) !important;
    border: 1px solid var(--button_border);
    border-radius: var(--border_radius);
    padding: var(--input_padding) var(--padding_wide);
}

QPushButton:hover,
QToolButton:hover {
    background-color: var(--button_bg_hover);
    border-color: var(--gb_indigo);
    color: var(--gb_azuki) !important;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: var(--button_bg_down);
    border-color: var(--gb_indigo_pressed);
    color: var(--gb_azuki_pressed) !important;
}

/* 選択・トグルボタン（外観の密度設定ボタン「クラシック」「通常」等） */
QPushButton:checked,
QToolButton:checked {
    background-color: var(--gb_start_select) !important;
    border: 2px solid var(--gb_azuki) !important;
    color: var(--text) !important; /* 実機START/SELECTボタンのラバーグレーに濃紫文字 */
    font-weight: bold;
}

QPushButton:checked:hover,
QToolButton:checked:hover {
    background-color: var(--gb_start_select_hover) !important;
    border-color: var(--gb_azuki_hover) !important;
    color: var(--text) !important;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: var(--button_bg_disabled);
    color: var(--text_disabled) !important;
    border-color: var(--gb_border);
}

QPushButton:focus,
QToolButton:focus {
    border-color: var(--gb_indigo);
}

/* =============================================================================
   4. 入力コントロール (テキスト, 数値, ドロップダウン)
   ============================================================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: var(--input_bg) !important;
    color: var(--input_text) !important;
    border: 1px solid var(--input_border);
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #bce248;
    selection-color: #214231;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: var(--input_bg_hover) !important;
    border-color: #709428;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    background-color: var(--input_bg_focus) !important;
    border: 1px solid var(--input_border_focus);
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #6e8620 !important;
    color: #3e5020 !important;
    border: 1px solid #566a18 !important;
}

/* ドロップダウン（コンボボックス）: 実機十字キー由来のマットブラックボタン */
QComboBox,
QDateTimeEdit {
    background-color: var(--input_bg) !important;
    color: var(--input_text) !important;
    border: 1px solid var(--input_border);
    border-radius: 3px;
    padding-left: 6px;
}

QComboBox:hover,
QDateTimeEdit:hover {
    background-color: var(--input_bg_hover) !important;
    border-color: #709428;
}

QComboBox:focus,
QDateTimeEdit:focus,
QDateTimeEdit:selected {
    background-color: var(--input_bg_focus) !important;
    border-color: var(--input_border_focus);
}

QComboBox:disabled,
QDateTimeEdit:disabled {
    background-color: #6e8620 !important;
    color: #3e5020 !important;
    border: 1px solid #566a18 !important;
}

/* ドロップダウンボタン (十字キーマットブラック) */
QComboBox::drop-down,
QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background-color: #202022;
    border: none;
    border-left: 1px solid #141416;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

QComboBox::drop-down:hover,
QDateTimeEdit::drop-down:hover {
    background-color: #323236;
    border-left: 1px solid var(--gb_azuki);
}

QComboBox::drop-down:on,
QComboBox::drop-down:pressed,
QDateTimeEdit::drop-down:pressed {
    background-color: #121214;
    border-left: 1px solid #08080a;
}

QComboBox::drop-down:disabled,
QDateTimeEdit::drop-down:disabled {
    background-color: #252628;
    border: none;
    border-left: 1px solid #141416;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

QComboBox::down-arrow,
QDateTimeEdit::down-arrow,
QComboBox::down-arrow:editable,
QDateTimeEdit::down-arrow:editable {
    image: url(theme:Dark/collapse.svg);
    width: 8px;
    height: 8px;
}

QComboBox::down-arrow:disabled,
QDateTimeEdit::down-arrow:disabled {
    image: url(theme:Dark/collapse.svg);
    width: 8px;
    height: 8px;
}

/* ドロップダウンメニューのリスト項目: 選択・ホバー時の文字色反転（小豆色背景 + 純白枠 + 純白文字） */
QComboBox QAbstractItemView {
    background-color: #8cad28; /* 実機テトリスSTN液晶ベース黄緑 */
    border: 1px solid #6e923a;
    selection-background-color: #bce248;
    selection-color: #214231;
    outline: none;
}

QComboBox QAbstractItemView::item {
    color: #214231;
    padding: 4px 8px;
    min-height: 20px;
    border: 1px solid transparent;
}

/* ドロップダウンメニュー及びメニューの選択・ホバー・フォーカスの実機テトリスSTN液晶ハイライト */
QMenu::item:selected,
QMenu > QWidget:selected,
QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:selected {
    background-color: #bce248 !important;
    border: 1px solid #214231 !important;
    color: #214231 !important;
}

QMenu::item:hover,
QComboBox QAbstractItemView::item:hover,
QComboBox QListView::item:hover {
    background-color: #9ec03e !important;
    border: 1px solid #709428 !important;
    color: #214231 !important;
}

QMenu::item:selected:hover,
QComboBox QAbstractItemView::item:selected:hover,
QComboBox QListView::item:selected:hover {
    background-color: #c8ea54 !important;
    border: 1px solid #214231 !important;
    color: #214231 !important;
}

QMenu::item:focus,
QMenu::item:selected:focus,
QComboBox QAbstractItemView::item:selected:focus,
QComboBox QListView::item:selected:focus {
    background-color: #bce248 !important;
    border: 1px solid #214231 !important;
    color: #214231 !important;
}
#previewScalingMode {
    background-color: transparent !important;
    color: var(--text) !important;
    border: 1px solid var(--gb_border) !important;
    border-radius: 0px !important;
    height: 14px !important;
    max-height: 14px !important;
    min-height: 14px !important;
    padding: 0px 4px !important;
    margin: 0px !important;
    font-size: var(--font_xsmall);
}

#previewScalingMode::drop-down {
    background-color: #202022 !important;
    border: none !important;
    border-left: 1px solid #141416 !important;
    border-radius: 0px !important;
    border-top-right-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
    width: 14px !important;
    height: 14px !important;
}

#previewScalingMode::drop-down:hover {
    background-color: #323236 !important;
}

#previewScalingMode::down-arrow {
    image: url(theme:Dark/collapse.svg) !important;
    width: 7px !important;
    height: 7px !important;
}

#previewScalePercent {
    color: var(--text) !important;
    font-size: var(--font_xsmall);
}

/* スピンボックス: 実機十字キー由来のマットブラックボタン + 白矢印 */
/* スピンボックス: 十字キー調のマットブラックボタン + テトリスSTN液晶 */
QSpinBox,
QDoubleSpinBox {
    background-color: var(--input_bg) !important;
    color: var(--input_text) !important;
    border: 1px solid var(--input_border);
    border-radius: 3px;
    padding-right: 18px;
    padding-left: 6px;
    selection-background-color: #bce248;
    selection-color: #214231;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    background-color: var(--input_bg_hover) !important;
    border-color: #709428;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: var(--input_bg_focus) !important;
    border-color: var(--input_border_focus);
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #6e8620 !important;
    color: #3e5020 !important;
    border: 1px solid #566a18 !important;
}

/* スピンボタン (十字キーマットブラック) */
QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    background-color: #202022;
    border: none;
    border-left: 1px solid #141416;
    border-bottom: 1px solid #141416;
    border-top-right-radius: 2px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover {
    background-color: #323236;
    border-left: 1px solid var(--gb_azuki);
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed {
    background-color: #121214;
    border-left: 1px solid #08080a;
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled {
    background-color: #252628;
    border: none;
    border-left: 1px solid #141416;
    border-bottom: 1px solid #141416;
    border-top-right-radius: 2px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 18px;
    background-color: #202022;
    border: none;
    border-left: 1px solid #141416;
    border-bottom-right-radius: 2px;
}

QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #323236;
    border-left: 1px solid var(--gb_azuki);
}

QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: #121214;
    border-left: 1px solid #08080a;
}

QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled {
    background-color: #252628;
    border: none;
    border-left: 1px solid #141416;
    border-bottom-right-radius: 2px;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(theme:Dark/up.svg);
    width: 7px;
    height: 7px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(theme:Dark/down.svg);
    width: 7px;
    height: 7px;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
    image: url(theme:Dark/up.svg);
    width: 7px;
    height: 7px;
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: url(theme:Dark/down.svg);
    width: 7px;
    height: 7px;
}

/* グループボックス: 枠線とタイトルの位置ずれ解消 & 設定画面での縦領域最適化 */
QGroupBox {
    background-color: transparent;
    color: #121644 !important;
    border: 1px solid var(--gb_border);
    border-radius: 4px;
    margin-top: 6px;
    padding-top: 10px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    font-weight: bold;
}

QGroupBox::title {
    color: #121644 !important;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 0px;
    padding: 0 8px;
    background-color: var(--gb_body);
}

/* 警告・エラーメッセージの視認性最大化（明るい背景での溶け込みを防止） */
.text-warning,
QLabel[class="text-warning"],
QLabel#simpleOutRecWarning,
QLabel#advOutRecWarning {
    color: var(--gb_azuki) !important; /* 明るい背景でくっきり読めるディープアンバーオレンジ */
    font-weight: bold;
}

.text-danger,
QLabel[class="text-danger"] {
    color: #b30018 !important; /* 明るい背景でくっきり読めるクラシック深紅 */
    font-weight: bold;
}

/* スタジオモードのプレビュー／プログラムラベルの視認性確保（白文字化を完全解消） */
.label-preview-title {
    color: var(--gb_azuki) !important;
    font-size: var(--font_xlarge);
    font-weight: bold;
}

/* =============================================================================
   5. リスト・ツリー・テーブル (SceneTree, SourceTree 等) の文字切れ解消
   ============================================================================= */

/* =============================================================================
   5. リスト・ツリー・テーブル (SceneTree, SourceTree, QListView, QListWidget)
   ============================================================================= */

QAbstractItemView {
    background-color: #8cad28; /* 実機テトリスSTN液晶ベース黄緑 (RGB: 140, 173, 40) */
    color: #214231;            /* 実機テトリス最暗ドット前景色 (RGB: 33, 66, 49) */
    border: 1px solid #6e923a;
}

/* シーン・ソースツリー・汎用リストボックス: 実機STN液晶オリーブグリーン背景 */
SceneTree,
SourceTree,
QListView,
QListWidget,
QTreeView,
QTableView {
    background-color: #8cad28;
    color: #214231 !important;
    border: 1px solid #6e923a;
}

/* 通常アイテム: 実機最暗液晶ドットピクセル前景色 (#214231) */
QListView::item,
QListWidget::item,
SceneTree::item,
SourceTree::item,
SourceTreeItem,
SourceTreeItem QLabel {
    color: #214231 !important;
    font-weight: bold;
}

/* マウスオーバー時 (Hover): 一段明るいオリーブグロー (#9ec03e) でハイライトと明確に差別化 */
QListView::item:hover,
QListWidget::item:hover,
SceneTree::item:hover,
SourceTree::item:hover {
    background-color: #9ec03e !important;
    border: 1px solid #709428 !important;
    color: #214231 !important;
}

/* 確定選択時 (Selected): 鮮明な最高明度ハイライトオリーブ (#bce248) + 実機最暗ドット枠線 (#214231) */
SceneTree::item:selected,
SourceTree::item:selected,
QListView::item:selected,
QListWidget::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #bce248 !important;
    border: 1px solid #214231 !important;
    color: #214231 !important;
    font-weight: bold;
}

/* 選択行のラベル文字色は ::item:selected で制御済み (子孫結合子によるパーサーバグ回避) */

/* 選択行にマウスオーバー時 (Selected:Hover): 選択状態を保ちつつさらに光るグロー (#c8ea54) */
SceneTree::item:selected:hover,
SourceTree::item:selected:hover,
QListView::item:selected:hover,
QListWidget::item:selected:hover {
    background-color: #c8ea54 !important;
    border: 1px solid #214231 !important;
    color: #214231 !important;
    font-weight: bold;
}

/* フォーカス枠 */
QListView::item:focus,
QListWidget::item:focus,
SceneTree::item:focus,
SourceTree::item:focus,
SceneTree::item:selected:focus,
SourceTree::item:selected:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border: 1px solid #214231 !important;
}
/* =============================================================================
   6. 設定ダイアログ (OBSBasicSettings) の完全最適化
   ============================================================================= */

OBSBasicSettings {
    background-color: var(--gb_body);
    qproperty-generalIcon: url(theme:Light/settings/general.svg);
    qproperty-appearanceIcon: url(theme:Light/settings/appearance.svg);
    qproperty-streamIcon: url(theme:Light/settings/stream.svg);
    qproperty-outputIcon: url(theme:Light/settings/output.svg);
    qproperty-audioIcon: url(theme:Light/settings/audio.svg);
    qproperty-videoIcon: url(theme:Light/settings/video.svg);
    qproperty-hotkeysIcon: url(theme:Light/settings/hotkeys.svg);
    qproperty-accessibilityIcon: url(theme:Light/settings/accessibility.svg);
    qproperty-advancedIcon: url(theme:Light/settings/advanced.svg);
}

/* 設定ダイアログの左側サイドバー: 初代ゲームボーイのSTN液晶画面（Dot Matrix LCD）の完全再現 */
OBSBasicSettings QListWidget {
    background-color: #8cad28; /* 実機テトリスSTN液晶ベース黄緑 */
    border: none;
    border-right: 2px solid #6e923a;
    padding: 8px 6px;
    selection-background-color: #bce248;
    selection-color: #214231;
}

OBSBasicSettings QListWidget::item {
    padding: var(--padding_large) var(--padding_wide);
    margin: 2px 0;
    border: 1px solid transparent;
    border-radius: var(--border_radius);
    color: #214231 !important; /* 実機最暗液晶ドットピクセル色 */
    font-weight: bold;
}

OBSBasicSettings QListWidget::item:hover {
    background-color: #9ec03e; /* マウスオーバー: 一段明るいオリーブグロー */
    border: 1px solid #709428;
    color: #214231 !important;
}

/* 確定選択時: 鮮明な最高明度ハイライトオリーブ (#bce248) + ドット枠線 */
OBSBasicSettings QListWidget::item:selected,
OBSBasicSettings QListWidget::item:selected:focus {
    background-color: #bce248 !important;
    border: 1px solid #214231 !important;
    color: #214231 !important;
    font-weight: bold;
}

OBSBasicSettings QListWidget::item:selected:hover {
    background-color: #c8ea54 !important;
    border: 1px solid #214231 !important;
    color: #214231 !important;
    font-weight: bold;
}

OBSBasicSettings QListWidget::item:focus {
    border: 1px solid #214231 !important;
}
OBSBasicSettings QDialogButtonBox QPushButton {
    background-color: #b0b4be !important; /* ゲームボーイ START ボタンのラバーグレー */
    color: #121644 !important; /* 実機刻印インディゴ文字 */
    border: 1px solid #888c98 !important;
    border-radius: var(--border_radius);
    min-width: 75px;
    padding: var(--input_padding) var(--padding_wide);
    font-weight: bold;
}

OBSBasicSettings QDialogButtonBox QPushButton:hover {
    background-color: var(--gb_start_select_hover) !important;
    border-color: #686e7a !important;
    color: #121644 !important;
}

/* OKボタン（確定）: ゲームボーイ A/Bボタンの小豆色背景 + 白文字 */
OBSBasicSettings QDialogButtonBox QPushButton:default {
    background-color: var(--gb_azuki) !important;
    color: #ffffff !important;
    border: 1px solid var(--gb_azuki_pressed) !important;
}

OBSBasicSettings QDialogButtonBox QPushButton:default:hover {
    background-color: var(--gb_azuki_hover) !important;
    border-color: var(--gb_indigo) !important;
    color: #ffffff !important;
}

/* 適用ボタン等の無効時（変更がない状態） */
OBSBasicSettings QDialogButtonBox QPushButton:disabled {
    background-color: #c8cad0 !important;
    color: #767a84 !important;
    border-color: #b0b4be !important;
}

/* =============================================================================
   7. コントロールボタン (ゲームボーイ実機パーツカラー: 小豆色・ラバーグレー・十字キー黒・成型色白)
   ============================================================================= */

#streamButton,
#recordButton,
#virtualCamButton,
#modeSwitch,
#settingsButton,
#exitButton {
    border-radius: var(--border_radius);
    padding: var(--padding_large);
    font-weight: normal;
}

/* --- 配信ボタン (GB 小豆色: Maroon) --- */
QPushButton#streamButton {
    background-color: var(--gb_azuki);
    color: #ffffff !important;
    border: 2px solid #7d0e16;
}

QPushButton#streamButton:hover {
    background-color: var(--gb_azuki_hover);
    border: 2px solid var(--gb_indigo);
    color: #ffffff !important;
}

QPushButton#streamButton:pressed {
    background-color: var(--gb_azuki_pressed);
    border: 2px solid #7d0e16;
    color: #ffffff !important;
}

/* 配信中（アクティブ時）: 深いえんじ背景 + 小豆発光ボーダー + ホバー時も絶対に白文字維持 */
#streamButton:!hover:!pressed.state-active,
#streamButton:hover:!pressed.state-active,
#streamButton.state-active,
#streamButton:checked,
#streamButton:hover:checked,
#streamButton:focus.state-active,
#streamButton:hover.state-active,
QPushButton#streamButton.state-active,
QPushButton#streamButton:checked,
QPushButton#streamButton:!hover:!pressed.state-active,
QPushButton#streamButton:hover:!pressed.state-active,
QPushButton#streamButton:hover.state-active,
QPushButton#streamButton:hover:checked {
    background-color: #550a12 !important;
    border: 2px solid var(--gb_azuki_glow) !important;
    color: #ffffff !important;
    font-weight: bold;
}

/* --- 録画ボタン (初代ゲームボーイ START / SELECT ボタン: Rubber Grey + 濃紫印字) --- */
/* --- 録画ボタン (GB 小豆色: A/B ボタン対応) --- */
QPushButton#recordButton {
    background-color: var(--gb_azuki);
    color: #ffffff !important;
    border: 1px solid #7d0e16;
    font-weight: bold;
}

QPushButton#recordButton:hover {
    background-color: var(--gb_azuki_hover);
    border: 2px solid var(--gb_indigo);
    color: #ffffff !important;
}

QPushButton#recordButton:pressed {
    background-color: var(--gb_azuki_pressed);
    border: 2px solid #7d0e16;
    color: #ffffff !important;
}

/* 録画中（アクティブ・ON時）: #121644 */
#recordButton:!hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#recordButton.state-active,
#recordButton:checked,
#recordButton:hover:checked,
#recordButton:focus.state-active,
#recordButton:hover.state-active,
QPushButton#recordButton.state-active,
QPushButton#recordButton:checked,
QPushButton#recordButton:!hover:!pressed.state-active,
QPushButton#recordButton:hover:!pressed.state-active,
QPushButton#recordButton:hover.state-active,
QPushButton#recordButton:hover:checked {
    background-color: #121644 !important;
    border: 2px solid var(--gb_indigo_glow) !important;
    color: #ffffff !important;
    font-weight: bold;
}
QPushButton#pauseRecordButton {
    background-color: #b0b4be;
    color: #121644 !important;
    border: 1px solid #888c98;
    font-weight: bold;
}

QPushButton#pauseRecordButton:hover {
    background-color: var(--gb_start_select_hover);
    border-color: var(--gb_azuki);
    color: var(--text) !important;
}

QPushButton#pauseRecordButton.state-active,
QPushButton#pauseRecordButton:checked,
QPushButton#pauseRecordButton:!hover:!pressed.state-active {
    background-color: #121644 !important;
    border: 2px solid var(--gb_indigo_glow) !important;
    color: #ffffff !important;
}

/* --- 仮想カメラボタン (GB コントローラー十字キー・ボタン: Matte Black) --- */
/* --- 仮想カメラボタン (START/SELECT ラバーグレー) --- */
QPushButton#virtualCamButton {
    background-color: #b0b4be;
    color: #121644 !important;
    border: 1px solid #888c98;
    font-weight: bold;
}

QPushButton#virtualCamButton:hover {
    background-color: var(--gb_start_select_hover);
    border-color: var(--gb_azuki);
    color: #121644 !important;
}

QPushButton#virtualCamButton:pressed {
    background-color: var(--gb_start_select_pressed);
    color: #121644 !important;
}

/* 仮想カメラ稼働中（アクティブ）: 小豆色 */
QPushButton#virtualCamButton.state-active,
QPushButton#virtualCamButton:checked,
QPushButton#virtualCamButton:!hover:!pressed.state-active,
QPushButton#virtualCamButton:hover.state-active,
QPushButton#virtualCamButton:hover:checked {
    background-color: var(--gb_azuki) !important;
    border: 2px solid var(--gb_azuki_glow) !important;
    color: #ffffff !important;
    font-weight: bold;
}

/* 仮想カメラ設定（歯車）ボタン: ラバーグレー + 暗色アイコン */
QPushButton#virtualCamConfigButton {
    background-color: #b0b4be !important;
    border: 1px solid #888c98 !important;
    border-radius: var(--border_radius);
    padding: var(--padding_large);
    width: var(--input_height);
    max-width: var(--input_height);
    color: #121644 !important;
    qproperty-icon: url(theme:Light/settings/general.svg);
}

QPushButton#virtualCamConfigButton:hover {
    background-color: var(--gb_start_select_hover) !important;
    border-color: var(--gb_azuki) !important;
    qproperty-icon: url(theme:Light/settings/general.svg);
}

/* --- スタジオモード切替 (START/SELECT ラバーグレー) --- */
QPushButton#modeSwitch {
    background-color: #b0b4be;
    color: #121644 !important;
    border: 1px solid #888c98;
    font-weight: bold;
}

QPushButton#modeSwitch:hover {
    background-color: var(--gb_start_select_hover);
    border-color: var(--gb_azuki);
    color: #121644 !important;
}

QPushButton#modeSwitch:pressed {
    background-color: var(--gb_start_select_pressed);
    color: #121644 !important;
}

/* スタジオモードON（アクティブ）: 小豆色ベタ */
QPushButton#modeSwitch.state-active,
QPushButton#modeSwitch:checked,
QPushButton#modeSwitch:!hover:!pressed.state-active,
QPushButton#modeSwitch:hover.state-active,
QPushButton#modeSwitch:hover:checked {
    background-color: var(--gb_azuki) !important;
    border: 2px solid var(--gb_azuki_glow) !important;
    color: #ffffff !important;
    font-weight: bold;
}

/* --- 設定・終了ボタン (START/SELECT ラバーグレー) --- */
QPushButton#settingsButton,
QPushButton#exitButton {
    background-color: #b0b4be;
    color: #121644 !important;
    border: 1px solid #888c98;
    font-weight: bold;
}

QPushButton#settingsButton:hover,
QPushButton#exitButton:hover {
    background-color: var(--gb_start_select_hover);
    border-color: var(--gb_azuki);
    color: #121644 !important;
}

QPushButton#settingsButton:pressed,
QPushButton#exitButton:pressed {
    background-color: var(--gb_start_select_pressed);
    color: #121644 !important;
}

#contextContainer {
    background-color: var(--gb_body);
}

#contextContainer QPushButton {
    background-color: transparent !important;
    border: 1px solid transparent !important;
    border-radius: var(--border_radius);
    padding: 3px 6px;
}

#contextContainer QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.08) !important;
    border: 1px solid var(--gb_border) !important;
}

#contextContainer QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.15) !important;
}

/* =============================================================================
   8. 音声ミキサー & スライダー (初代ゲームボーイ ハードウェアモチーフ完全再現)
   ============================================================================= */

/* ミキサーベースコンテナ */
#mixerContainer,
#mixerArea {
    background-color: var(--gb_body);
}

/* チャンネルストリップ (各音声チャンネル): 初代ゲームボーイの成型色ホワイト + 小豆色アクセントライン */
#vVolumeWidgets VolumeControl,
#hVolumeWidgets VolumeControl {
    background-color: #ffffff;
    border: 1px solid var(--gb_border);
    border-right: 2px solid var(--gb_azuki);
    padding: 4px;
}

/* チャンネル名（「デスクトップ音声」「マイク」等）: 実機印字の濃紫テキスト */
VolumeControl .mixer-name,
#vVolumeWidgets VolumeControl QLabel,
#hVolumeWidgets VolumeControl QLabel {
    color: var(--text) !important;
    font-weight: bold;
}

/* 音量数値ラベル（0.0 dB 等）: 実機印字の濃紫テキスト */
VolumeControl #volLabel,
#vVolumeWidgets VolumeControl #volLabel,
#hVolumeWidgets VolumeControl #volLabel {
    color: var(--text) !important;
    font-weight: bold;
}

/* ミキサーヘッダーバー: ゲームボーイ小豆色 */
#mixerContainer QWidget[header="true"] QLabel,
#mixerContainer QLabel#header,
#mixerContainer .header {
    background-color: var(--gb_azuki);
    color: #ffffff !important;
    padding: 3px 8px;
    font-weight: bold;
    border-radius: 3px;
}

/* カテゴリバッジ（初代ゲームボーイ右上のパンチングマイク穴グリルを模した小豆色バッジ） */
VolumeControl .mixer-category,
VolumeControl QLabel.mixer-category,
#vVolumeWidgets VolumeControl QLabel.mixer-category,
#hVolumeWidgets VolumeControl QLabel.mixer-category,
QLabel.mixer-category {
    background: var(--gb_azuki) !important;
    color: #ffffff !important;
    border: 1px solid var(--gb_indigo) !important;
    font-size: 10px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 3px;
}

/* グローバル（ピン留め）カテゴリバッジ: 十字キーマットブラック + 青紫/小豆色枠 + 白文字 */
VolumeControl.volume-pinned .mixer-category,
VolumeControl.volume-pinned QLabel.mixer-category,
#vVolumeWidgets VolumeControl.volume-pinned QLabel.mixer-category,
#hVolumeWidgets VolumeControl.volume-pinned QLabel.mixer-category {
    background: #1a1a1c !important;
    color: #ffffff !important;
    border: 1px solid var(--gb_indigo) !important;
}

/* 非アクティブカテゴリ */
VolumeControl.volume-inactive .mixer-category,
VolumeControl.volume-inactive QLabel.mixer-category {
    background: var(--gb_border) !important;
    color: #4a4235 !important;
    border: 1px solid var(--gb_border) !important;
}

/* プレビューカテゴリ */
VolumeControl.volume-preview .mixer-category,
VolumeControl.volume-preview QLabel.mixer-category {
    background: var(--gb_azuki) !important;
    color: #ffffff !important;
    border: 1px solid var(--gb_indigo) !important;
}

/* --- 初代ゲームボーイ 音量スライダー (VOLUME) の完全再現 --- */

/* =============================================================================
   スライダー（音量フェーダー & 設定スライダー）
   初代ゲームボーイの成型プラスチック溝（ベゼルグレー）と小豆色進捗ゲージ、青紫ノブの調和
   ============================================================================= */

/* 水平スライダー溝 (ベースレール): ゲームボーイ実機の成型窪み溝（ベゼルグレー） */
QSlider::groove:horizontal,
#hVolumeWidgets VolumeControl QSlider::groove:horizontal {
    background-color: #d6d8ce;
    border: 1px solid #b8baa8;
    height: 4px;
    border-radius: 2px;
}

/* 到達側（アクティブ進捗）: 初代ゲームボーイの小豆色（マルーン） */
QSlider::sub-page:horizontal,
#hVolumeWidgets VolumeControl QSlider::sub-page:horizontal {
    background-color: var(--gb_azuki) !important;
    border: 1px solid #7d0e16;
    border-radius: 2px;
}

/* 未達側（残量）: 落ち着いた成型溝色 */
QSlider::add-page:horizontal,
#hVolumeWidgets VolumeControl QSlider::add-page:horizontal {
    background-color: #d6d8ce !important;
    border: 1px solid #b8baa8;
    border-radius: 2px;
}

/* 垂直スライダー溝 (ベースレール) */
QSlider::groove:vertical,
#vVolumeWidgets VolumeControl QSlider::groove:vertical {
    background-color: #d6d8ce;
    border: 1px solid #b8baa8;
    width: 4px;
    border-radius: 2px;
}

/* 到達側（アクティブ進捗）: 下側が0、上が最大値のため add-page が到達部 */
QSlider::add-page:vertical,
#vVolumeWidgets VolumeControl QSlider::add-page:vertical {
    background-color: var(--gb_azuki) !important;
    border: 1px solid #7d0e16;
    border-radius: 2px;
}

/* 未達側（残量部） */
QSlider::sub-page:vertical,
#vVolumeWidgets VolumeControl QSlider::sub-page:vertical {
    background-color: #d6d8ce !important;
    border: 1px solid #b8baa8;
    border-radius: 2px;
}

/* スライダーつまみ（垂直フェーダー）: 実機音量ダイヤル・START/SELECTのラバーグレー + 小豆色アクセント */
QSlider::handle:vertical,
#vVolumeWidgets VolumeControl QSlider::handle:vertical {
    background-color: var(--gb_dial) !important;
    border: 1px solid #ffffff;
    border-top: 2px solid var(--gb_azuki);
    border-bottom: 2px solid var(--gb_azuki);
    border-radius: 3px;
    width: 20px;
    height: 12px;
    margin: 0 -8px;
}

QSlider::handle:vertical:hover,
#vVolumeWidgets VolumeControl QSlider::handle:vertical:hover {
    background-color: var(--gb_dial_hover) !important;
    border-color: var(--gb_azuki_glow) !important;
}

QSlider::handle:vertical:pressed,
#vVolumeWidgets VolumeControl QSlider::handle:vertical:pressed {
    background-color: var(--gb_dial_pressed) !important;
    border-color: #ffffff !important;
}

/* スライダーつまみ（水平フェーダー）: 実機音量ダイヤル・START/SELECTのラバーグレー + 小豆色アクセント */
QSlider::handle:horizontal,
#hVolumeWidgets VolumeControl QSlider::handle:horizontal {
    background-color: var(--gb_dial) !important;
    border: 1px solid #ffffff;
    border-left: 2px solid var(--gb_azuki);
    border-right: 2px solid var(--gb_azuki);
    border-radius: 3px;
    width: 12px;
    height: 20px;
    margin: -8px 0;
}

QSlider::handle:horizontal:hover,
#hVolumeWidgets VolumeControl QSlider::handle:horizontal:hover {
    background-color: var(--gb_dial_hover) !important;
    border-color: var(--gb_azuki_glow) !important;
}

QSlider::handle:horizontal:pressed,
#hVolumeWidgets VolumeControl QSlider::handle:horizontal:pressed {
    background-color: var(--gb_dial_pressed) !important;
    border-color: #ffffff !important;
}

/* --- 初代ゲームボーイ 丸ボタン & MIC. ボタン --- */

/* モニタリングボタン（ヘッドフォン）: 初代ゲームボーイの丸ボタン風ブラックサークル */
.btn-monitor {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    qproperty-icon: url(theme:Light/headphones-off.svg);
}

.btn-monitor:hover {
    background-color: var(--gb_start_select_hover);
    border-color: var(--gb_azuki);
}

/* モニタリングON時: 十字キー黒丸ボタン + 小豆色枠 + 白ヘッドフォンアイコン */
.btn-monitor.checked,
.btn-monitor:checked {
    color: #ffffff !important;
    background: #1c1c1e !important;
    border: 2px solid var(--gb_indigo) !important;
    border-radius: 4px;
    qproperty-icon: url(theme:Dark/headphones.svg) !important;
}

/* ミュートボタン: 通常は濃紫アイコン、ミュート時は小豆色背景 + 白ミュートアイコン */
.btn-mute {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    qproperty-icon: url(theme:Light/settings/audio.svg);
}

.btn-mute:hover {
    background-color: var(--gb_start_select_hover);
    border-color: var(--gb_azuki);
}

/* ミュート時: 小豆色背景の上にクッキリと映える「白い」ミュートアイコン（Dark/mute.svg）を採用！
   ※OBSの applyColorToIcon() が buttonText (color) でアイコンを再着色するため、color: #ffffff !important が必須！ */
.btn-mute.checked,
.btn-mute:checked {
    color: #ffffff !important;
    background: var(--gb_azuki) !important;
    border: 1px solid #7d0e16 !important;
    border-radius: 4px;
    qproperty-icon: url(theme:Dark/mute.svg) !important;
}

.btn-mute.checked:hover,
.btn-mute:checked:hover {
    color: #ffffff !important;
    background: var(--gb_azuki_hover) !important;
    border-color: var(--gb_indigo) !important;
    qproperty-icon: url(theme:Dark/mute.svg) !important;
}

/* 音声ボリュームメーター: 初代ゲームボーイの音量インジケーター（目盛り・数字）を黒で強調 */
VolumeMeter {
    qproperty-backgroundNominalColor: #28a745;
    qproperty-backgroundWarningColor: var(--gb_indigo);
    qproperty-backgroundErrorColor: #98161f;
    qproperty-foregroundNominalColor: #1e8f42;
    qproperty-foregroundWarningColor: var(--gb_azuki);
    qproperty-foregroundErrorColor: #7d0e16;
    qproperty-magnitudeColor: var(--text);
    qproperty-majorTickColor: var(--text);
    qproperty-minorTickColor: #8c8474;
}

/* =============================================================================
   9. Light テーマ標準アイコンの継承・明示指定
   ============================================================================= */

OBSBasic {
    qproperty-imageIcon: url(theme:Light/sources/image.svg);
    qproperty-colorIcon: url(theme:Light/sources/brush.svg);
    qproperty-slideshowIcon: url(theme:Light/sources/slideshow.svg);
    qproperty-audioInputIcon: url(theme:Light/sources/microphone.svg);
    qproperty-audioOutputIcon: url(theme:Light/settings/audio.svg);
    qproperty-desktopCapIcon: url(theme:Light/settings/video.svg);
    qproperty-windowCapIcon: url(theme:Light/sources/window.svg);
    qproperty-gameCapIcon: url(theme:Light/sources/gamepad.svg);
    qproperty-cameraIcon: url(theme:Light/sources/camera.svg);
    qproperty-textIcon: url(theme:Light/sources/text.svg);
    qproperty-mediaIcon: url(theme:Light/sources/media.svg);
    qproperty-browserIcon: url(theme:Light/sources/globe.svg);
    qproperty-groupIcon: url(theme:Light/sources/group.svg);
    qproperty-sceneIcon: url(theme:Light/sources/scene.svg);
    qproperty-defaultIcon: url(theme:Light/sources/default.svg);
    qproperty-audioProcessOutputIcon: url(theme:Light/sources/windowaudio.svg);
}

.icon-plus             { qproperty-icon: url(theme:Light/plus.svg); }
.icon-minus            { qproperty-icon: url(theme:Light/minus.svg); }
.icon-trash            { qproperty-icon: url(theme:Light/trash.svg); }
.icon-clear            { qproperty-icon: url(theme:Light/entry-clear.svg); }
.icon-gear             { qproperty-icon: url(theme:Light/settings/general.svg); }
.icon-dots-vert        { qproperty-icon: url(theme:Light/dots-vert.svg); }
.icon-refresh          { qproperty-icon: url(theme:Light/refresh.svg); }
.icon-cogs             { qproperty-icon: url(theme:Light/cogs.svg); }
.icon-touch            { qproperty-icon: url(theme:Light/interact.svg); }
.icon-up               { qproperty-icon: url(theme:Light/up.svg); }
.icon-down             { qproperty-icon: url(theme:Light/down.svg); }
.icon-filter           { qproperty-icon: url(theme:Light/filter.svg); }
.icon-revert           { qproperty-icon: url(theme:Light/revert.svg); }
.icon-close            { qproperty-icon: url(theme:Light/close.svg); }
.icon-layout-vertical  { qproperty-icon: url(theme:Light/layout-vertical.svg); }
.icon-layout-horizontal{ qproperty-icon: url(theme:Light/layout-horizontal.svg); }

/* =============================================================================
   10. スクロールバー (実機十字キー由来のマットブラック × オリーブ画面トラック)
   ============================================================================= */
QScrollBar:vertical,
#previewYScrollBar,
OBSBasicSettings QScrollBar:vertical,
OBSDock QScrollBar:vertical {
    background-color: var(--gb_screen_bg);
    width: 16px !important;
    border: none !important;
    margin: 16px 0px 16px 0px !important;
}

QScrollBar:horizontal,
#previewXScrollBar,
OBSBasicSettings QScrollBar:horizontal,
OBSDock QScrollBar:horizontal {
    background-color: var(--gb_screen_bg);
    height: 16px !important;
    border: none !important;
    margin: 0px 16px 0px 16px !important;
}

/* つまみ (実機十字キーのマットブラック: ボタンと太さを完全一致) */
QScrollBar::handle:vertical,
#previewYScrollBar::handle,
OBSBasicSettings QScrollBar::handle:vertical,
OBSDock QScrollBar::handle:vertical {
    background-color: #2b2d30;
    border: 1px solid #484c56;
    border-top: 2px solid #6c7080;
    border-bottom: 2px solid #6c7080;
    min-height: 24px;
    margin: 0px !important;
    border-radius: 0px !important;
}

QScrollBar::handle:vertical:hover,
#previewYScrollBar::handle:hover,
OBSBasicSettings QScrollBar::handle:vertical:hover,
OBSDock QScrollBar::handle:vertical:hover {
    background-color: #323236;
    border: 1px solid var(--gb_azuki);
}

QScrollBar::handle:vertical:pressed,
#previewYScrollBar::handle:pressed,
OBSBasicSettings QScrollBar::handle:vertical:pressed,
OBSDock QScrollBar::handle:vertical:pressed {
    background-color: #121214;
    border: 1px solid #08080a;
}

QScrollBar::handle:horizontal,
#previewXScrollBar::handle,
OBSBasicSettings QScrollBar::handle:horizontal,
OBSDock QScrollBar::handle:horizontal {
    background-color: #2b2d30;
    border: 1px solid #484c56;
    border-left: 2px solid #6c7080;
    border-right: 2px solid #6c7080;
    min-width: 24px;
    margin: 0px !important;
    border-radius: 0px !important;
}

QScrollBar::handle:horizontal:hover,
#previewXScrollBar::handle:hover,
OBSBasicSettings QScrollBar::handle:horizontal:hover,
OBSDock QScrollBar::handle:horizontal:hover {
    background-color: #323236;
    border: 1px solid var(--gb_azuki);
}

QScrollBar::handle:horizontal:pressed,
#previewXScrollBar::handle:pressed,
OBSBasicSettings QScrollBar::handle:horizontal:pressed,
OBSDock QScrollBar::handle:horizontal:pressed {
    background-color: #121214;
    border: 1px solid #08080a;
}

/* 矢印ボタン (十字キーマットブラック + 白矢印) */
QScrollBar::add-line:vertical,
#previewYScrollBar::add-line {
    background-color: #1c1e20;
    border: 1px solid #141416;
    border-top: 2px solid #525662;
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical,
#previewYScrollBar::sub-line {
    background-color: #1c1e20;
    border: 1px solid #141416;
    border-bottom: 2px solid #525662;
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover,
QScrollBar::sub-line:vertical:hover,
#previewYScrollBar::add-line:hover,
#previewYScrollBar::sub-line:hover {
    background-color: #323236;
    border: 1px solid var(--gb_azuki);
}

QScrollBar::add-line:vertical:pressed,
QScrollBar::sub-line:vertical:pressed,
#previewYScrollBar::add-line:pressed,
#previewYScrollBar::sub-line:pressed {
    background-color: #121214;
    border: 1px solid #08080a;
}

QScrollBar::add-line:horizontal,
#previewXScrollBar::add-line {
    background-color: #1c1e20;
    border: 1px solid #141416;
    border-left: 2px solid #525662;
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal,
#previewXScrollBar::sub-line {
    background-color: #1c1e20;
    border: 1px solid #141416;
    border-right: 2px solid #525662;
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover,
QScrollBar::sub-line:horizontal:hover,
#previewXScrollBar::add-line:hover,
#previewXScrollBar::sub-line:hover {
    background-color: #323236;
    border: 1px solid var(--gb_azuki);
}

QScrollBar::add-line:horizontal:pressed,
QScrollBar::sub-line:horizontal:pressed,
#previewXScrollBar::add-line:pressed,
#previewXScrollBar::sub-line:pressed {
    background-color: #121214;
    border: 1px solid #08080a;
}

QScrollBar::up-arrow:vertical,
#previewYScrollBar::up-arrow {
    image: url(theme:Dark/up.svg);
    width: 8px;
    height: 8px;
}

QScrollBar::down-arrow:vertical,
#previewYScrollBar::down-arrow {
    image: url(theme:Dark/down.svg);
    width: 8px;
    height: 8px;
}

QScrollBar::left-arrow:horizontal,
#previewXScrollBar::left-arrow {
    image: url(theme:Dark/left.svg);
    width: 8px;
    height: 8px;
}

QScrollBar::right-arrow:horizontal,
#previewXScrollBar::right-arrow {
    image: url(theme:Dark/right.svg);
    width: 8px;
    height: 8px;
}

/* =============================================================================
   ミキサー ミュート/モニター ボタン: ON/OFF 状態の明示分離（視認性強化）
   OFF: 透明背景 + 通常アイコン / ON: 赤(ミュート)・緑(モニター)背景 + 白アイコン
   ============================================================================= */
QPushButton.btn-mute:!checked,.btn-mute:!checked:!hover,
VolumeControl .btn-mute:!checked:!hover {
    color: #1a1a1a !important;
    background: transparent !important;
    border: 1px solid transparent !important;
    qproperty-icon: url(theme:Light/settings/audio.svg) !important;
}
QPushButton.btn-monitor:!checked,.btn-monitor:!checked:!hover,
VolumeControl .btn-monitor:!checked:!hover {
    color: #1a1a1a !important;
    background: transparent !important;
    border: 1px solid #4a4e78 !important;
    qproperty-icon: url(theme:Light/headphones-off.svg) !important;
}
QPushButton.btn-mute:checked, QPushButton.btn-mute.checked, .btn-mute:checked, .btn-mute.checked,
VolumeControl .btn-mute:checked {
    color: #ffffff !important;
    background: #c0243a !important;
    border: 1px solid #6a0e1e !important;
    qproperty-icon: url(theme:Dark/mute.svg) !important;
}
QPushButton.btn-monitor:checked, QPushButton.btn-monitor.checked, .btn-monitor:checked, .btn-monitor.checked,
VolumeControl .btn-monitor:checked {
    color: #ffffff !important;
    background: #2e9c4a !important;
    border: 1px solid #145a28 !important;
    qproperty-icon: url(theme:Dark/headphones.svg) !important;
}
