@OBSThemeMeta {
    name: '[1995] Windows Classic';
    id: 'com.obsproject.Yami.WindowsClassic';
    extends: 'com.obsproject.Yami.Light';
    author: 'kjozk & Antigravity';
    dark: 'false';
}

@OBSThemeVars {
    /* =========================================================================
       Windows Classic (Windows 95/98/2000/XPクラシック) 実機完全再現カラー
       ========================================================================= */
    --win_bg: #D4D0C8;           /* クラシック標準グレー (ButtonFace / 3DFace) */
    --win_bg_light: #FFFFFF;     /* 入力欄・リスト背景 (Window) */
    --win_bg_dark: #A09E96;      /* 暗色面 */
    --win_hilight: #FFFFFF;      /* ベベル明面ハイライト (3DLight) */
    --win_shadow: #808080;       /* ベベル暗面シャドウ (3DShadow) */
    --win_darkshadow: #404040;   /* ベベル最外縁ダークシャドウ (3DDKShadow) */

    /* --- タイトルバー (伝統のアクティブ濃紺グラデーション) --- */
    --win_title_active_start: #0A246A;
    --win_title_active_end:   #A6CAF0;
    --win_title_inactive_start: #808080;
    --win_title_inactive_end:   #B5B5B5;

    /* --- 選択・アクセント --- */
    --win_selection: #0A246A;    /* クラシック濃紺セレクション */
    --win_selection_text: #FFFFFF;

    /* --- 画面全体の背景定義 --- */
    --bg_window: var(--win_bg);
    --bg_base: var(--win_bg);
    --bg_preview: #242424;      /* プレビュー周囲 */

    /* =========================================================================
       文字色・パレット設定 (Light系完全準拠)
       ========================================================================= */
    --text: #000000;            /* メインテキスト: 完全な黒 */
    --text_light: #000000;      /* Light規約準拠: 親から継承されるテキスト用（白飛び防止） */
    --win_btn_text: #000000;    /* ボタン文字色 */
    --text_muted: #444444;      /* 補足テキスト */
    --text_inactive: #808080;
    --text_disabled: #808080;   /* 無効時グレー */

    /* Qt パレット完全上書き */
    --palette_windowText: #000000;
    --palette_windowText_active: #000000;
    --palette_windowText_inactive: #000000;
    --palette_windowText_disabled: #808080;
    --palette_text: #000000;
    --palette_text_active: #000000;
    --palette_text_inactive: #000000;
    --palette_text_disabled: #808080;
    --palette_buttonText: #000000;
    --palette_brightText: #000000;
    --palette_highlightedText: #FFFFFF;
    --palette_toolTipText: #000000;
    --palette_window: var(--win_bg);
    --palette_base: #FFFFFF;
    --palette_button: var(--win_bg);
    --palette_mid: var(--win_shadow);

    --primary: var(--win_title_active_start);
    --primary_light: var(--win_title_active_end);
    --primary_dark: #001040;

    --accent: var(--win_selection);
    --accent_hover: #15388A;
    --accent_pressed: #001550;

    --success: #008000;
    --warning: #808000;
    --danger: #800000;
}

/* =========================================================================
   1. 基本ウィジェット & フォント (MS UI Gothic 12px 完全再現)
   ========================================================================= */
QWidget {
    background-color: var(--win_bg);
    color: var(--text);
    selection-background-color: var(--win_selection);
    selection-color: var(--win_selection_text);
    font-family: 'MS UI Gothic', 'Tahoma', 'Meiryo UI', sans-serif;
    font-size: 12px;
}

QDialog,
QMainWindow,
OBSBasic {
    background-color: var(--win_bg);
    color: var(--text);
}

/* ツールチップ (クラシック イエローポップアップ) */
QToolTip {
    background-color: #FFFFE1;
    color: #000000;
    border: 1px solid #000000;
    padding: 3px 5px;
    font-size: 11px;
}

/* =========================================================================
   2. ドック・タイトルバー (Windows 2000/XPクラシック 濃紺グラデーション)
   ========================================================================= */
QDockWidget {
    color: #FFFFFF; /* タイトルバーの文字色: 濃紺上で鮮明な純白 */
    font-weight: bold;
    titlebar-close-icon: url(theme:Dark/close.svg);
    titlebar-normal-icon: url(theme:Dark/popout.svg);
}

QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0A246A,
        stop:1 #A6CAF0);
    border: 1px solid #0A246A;
    padding: 3px 6px;
    text-align: left;
    color: #FFFFFF;
}

/* ドック内フレーム (立体 Sunken 枠) */
OBSDock > QWidget {
    background-color: var(--win_bg);
    border: 1px solid var(--win_shadow);
    border-top: none;
    color: #000000;
}

/* ドック内コンテンツ文字色完全保護（QDockWidgetからの白文字継承を遮断） */
QDockWidget QWidget,
OBSDock QWidget,
OBSDock QLabel,
OBSDock QTreeView,
OBSDock QListView,
OBSDock QListWidget,
OBSDock QTableView,
OBSDock QPushButton,
OBSDock QCheckBox,
OBSDock QRadioButton {
    color: #000000;
}

/* =========================================================================
   3. タブバー (クラシックスクエア・ベベルタブ)
   ========================================================================= */

/* ドック下部タブ (QTabBar::tab:bottom) */
QTabBar::tab:bottom,
QTabBar::tab {
    background-color: var(--win_bg);
    color: var(--text);
    border-top: 1px solid var(--win_shadow);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_darkshadow);
    border-bottom: 1px solid var(--win_darkshadow);
    border-radius: 0px;
    padding: 3px 10px;
    margin-right: 2px;
    margin-top: -1px;
}

QTabBar::tab:bottom:selected,
QTabBar::tab:selected {
    background-color: var(--win_bg);
    color: #000000;
    font-weight: bold;
    border-top: none;
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    margin-top: 0px;
}

QTabBar::tab:bottom:hover:!selected,
QTabBar::tab:hover:!selected {
    background-color: #E4E0D8;
}

/* 上部タブ (QTabBar::tab:top) */
QTabBar::tab:top {
    background-color: var(--win_bg);
    color: var(--text);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_darkshadow);
    border-bottom: 1px solid var(--win_shadow);
    border-radius: 0px;
    padding: 3px 10px;
}

QTabBar::tab:top:selected {
    background-color: var(--win_bg);
    color: #000000;
    font-weight: bold;
    border-bottom: 1px solid var(--win_bg);
    margin-bottom: -1px;
}

/* =========================================================================
   4. 汎用プッシュボタン (Windows Classic 伝統の 3D Raised / Sunken ベベル)
   ========================================================================= */
QPushButton {
    background-color: var(--win_bg);
    color: #000000;
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    border-radius: 0px;
    padding: 3px 8px;
    min-height: 20px;
    min-width: 64px;
    font-weight: normal;
}

QPushButton:hover {
    background-color: #E0DCD4;
}

/* 押下時 (Sunken: 凹みベベル) */
QPushButton:pressed {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
    padding: 4px 7px 2px 9px; /* 押すとテキストが右下へ1px沈み込むクラシック演出 */
}

QPushButton:disabled {
    background-color: var(--win_bg);
    color: var(--text_disabled);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_shadow);
    border-bottom: 1px solid var(--win_shadow);
}

/* トグルボタン・選択中状態 */
QPushButton:checked,
QPushButton:checked:hover,
QPushButton.state-active,
QPushButton[state-active=\"true\"] {
    background-color: #E0DCD4 !important;
    border-top: 2px solid var(--win_darkshadow) !important;
    border-left: 2px solid var(--win_darkshadow) !important;
    border-right: 2px solid var(--win_hilight) !important;
    border-bottom: 2px solid var(--win_hilight) !important;
    color: #000000 !important;
    font-weight: bold;
}

/* デフォルトボタン (OKボタン等のクラシック立体外周枠: 上・左は1px、右・下は2pxの影) */
QPushButton:default {
    border-top: 1px solid #000000;
    border-left: 1px solid #000000;
    border-right: 2px solid #000000;
    border-bottom: 2px solid #000000;
}

QPushButton:default:pressed {
    border-top: 2px solid #000000;
    border-left: 2px solid #000000;
    border-right: 1px solid #000000;
    border-bottom: 1px solid #000000;
}

/* =========================================================================
   5. 入力コントロール (クラシック Sunken 窪み枠)
   ========================================================================= */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #FFFFFF;
    color: #000000;
    border-top: 2px solid var(--win_shadow);
    border-left: 2px solid var(--win_shadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
    border-radius: 0px;
    padding: 2px 4px;
    selection-background-color: var(--win_selection);
    selection-color: var(--win_selection_text);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 16px;
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
}

QComboBox::drop-down:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
}

QComboBox::drop-down:disabled {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_shadow);
    border-bottom: 2px solid var(--win_shadow);
}

QComboBox::down-arrow {
    image: url(theme:classic/down.svg);
    width: 7px;
    height: 5px;
}

QComboBox::down-arrow:disabled {
    image: url(theme:classic/down_disabled.svg);
    width: 7px;
    height: 5px;
}

/* スピンボックスのボタン (Windows クラシック Up-Down コントロール) */
QSpinBox,
QDoubleSpinBox {
    padding-right: 18px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 15px;
    height: 10px;
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_darkshadow);
    border-bottom: 1px solid var(--win_shadow);
    border-radius: 0px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover {
    background-color: var(--win_bg);
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed {
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_darkshadow);
    border-left: 1px solid var(--win_darkshadow);
    border-right: 1px solid var(--win_hilight);
    border-bottom: 1px solid var(--win_hilight);
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled {
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_shadow);
    border-bottom: 1px solid var(--win_shadow);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(theme:classic/up.svg);
    width: 7px;
    height: 5px;
}

QSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:off {
    image: url(theme:classic/up_disabled.svg);
    width: 7px;
    height: 5px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 15px;
    height: 10px;
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_darkshadow);
    border-bottom: 1px solid var(--win_darkshadow);
    border-radius: 0px;
}

QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: var(--win_bg);
}

QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_darkshadow);
    border-left: 1px solid var(--win_darkshadow);
    border-right: 1px solid var(--win_hilight);
    border-bottom: 1px solid var(--win_hilight);
}

QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled {
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_shadow);
    border-bottom: 1px solid var(--win_shadow);
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(theme:classic/down.svg);
    width: 7px;
    height: 5px;
}

QSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:off {
    image: url(theme:classic/down_disabled.svg);
    width: 7px;
    height: 5px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #000000;
    selection-background-color: var(--win_selection);
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item:selected {
    background-color: var(--win_selection) !important;
    color: #FFFFFF !important;
}

QCheckBox, QRadioButton {
    spacing: 6px;
    color: var(--text);
}

/* =========================================================================
   6. リスト・ツリー・テーブル (SceneTree, SourceTree, QAbstractItemView)
   ========================================================================= */
QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    selection-background-color: var(--win_selection);
    selection-color: #FFFFFF;
}

QListWidget,
QListView,
QTreeWidget,
QTreeView,
QTableWidget,
SourceTree,
SceneTree {
    background-color: #FFFFFF;
    color: #000000;
    border-top: 2px solid var(--win_shadow);
    border-left: 2px solid var(--win_shadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
    border-radius: 0px;
    selection-background-color: var(--win_selection);
    selection-color: var(--win_selection_text);
    show-decoration-selected: 1;
}

/* 通常時（未選択時）アイテム文字色完全保証 */
QAbstractItemView::item,
QListView::item,
QListWidget::item,
SceneTree::item,
SourceTree::item,
.list-grid SceneTree::item {
    color: #000000 !important;
    background-color: transparent;
}

/* ホバー時 */
QAbstractItemView::item:hover,
QListView::item:hover,
QListWidget::item:hover,
QTreeWidget::item:hover,
SceneTree::item:hover,
SourceTree::item:hover,
.list-grid SceneTree::item:hover {
    background-color: #E8F0FF !important;
    color: #000000 !important;
}

/* 選択時 (Windows Classic 濃紺背景 + 白文字) */
QAbstractItemView::item:selected,
QListView::item:selected,
QListWidget::item:selected,
QTreeWidget::item:selected,
SceneTree::item:selected,
SourceTree::item:selected,
.list-grid SceneTree::item:selected,
.list-grid SceneTree::item:selected:hover {
    background-color: var(--win_selection) !important;
    color: #FFFFFF !important;
}

/* 通常時（未選択時）アイテム文字色 */
SourceTreeItem,
SourceTreeItem QLabel,
SourceTreeItem OBSSourceLabel,
OBSDock QLabel {
    color: #000000;
}

/* 非表示（目が閉じている）ソーステキスト */
.text-muted,
QLabel.text-muted {
    color: #707070 !important;
}

/* 選択時の非表示ソーステキスト (子孫結合子によるパーサーバグ回避のため ::item:selected では指定しない) */

/* ヘッダー (クラシック 3D カラムヘッダー) */
QHeaderView::section {
    background-color: var(--win_bg);
    color: #000000;
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_darkshadow);
    border-bottom: 1px solid var(--win_darkshadow);
    padding: 2px 4px;
}

/* =========================================================================
   7. 設定ダイアログ (OBSBasicSettings: クラシック プロパティシート)
   ========================================================================= */
OBSBasicSettings {
    background-color: var(--win_bg);
}

OBSBasicSettings QListWidget#categories {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_shadow);
    border-left: 2px solid var(--win_shadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
    min-width: 160px;
}

OBSBasicSettings QListWidget#categories::item {
    padding: 6px 10px;
    color: #000000;
}

OBSBasicSettings QListWidget#categories::item:selected {
    background-color: #B6CBEB;
    border: 1px dotted #0A246A;
    color: #000000 !important;
    font-weight: bold;
}

/* グループボックス (Windows クラシック 彫刻刀で掘った溝: Etched Groove) */
QGroupBox {
    border: 2px groove #808080;
    border-radius: 0px;
    margin-top: 12px;
    padding-top: 12px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    font-weight: normal;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    background-color: var(--win_bg);
}

/* =========================================================================
   8. コントロールボタン (クラシック 3D ボタン)
   ========================================================================= */

/* --- 配信ボタン --- */
#streamButton {
    background-color: var(--win_bg);
    color: #006000 !important; /* クラシックダークグリーン文字 */
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    border-radius: 0px;
    font-weight: bold;
    font-size: 13px;
    padding: 5px 12px;
}

#streamButton:hover {
    background-color: #E0DCD4;
}

#streamButton:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
    padding: 6px 11px 4px 13px;
}

/* 配信中 (押し込み状態 + 赤文字) */
#streamButton:!hover:!pressed.state-active,
#streamButton:hover:!pressed.state-active,
#streamButton.state-active,
#streamButton:checked,
#streamButton:hover:checked {
    background-color: #D8D4CC !important;
    color: #C00000 !important;
    border-top: 2px solid var(--win_darkshadow) !important;
    border-left: 2px solid var(--win_darkshadow) !important;
    border-right: 2px solid var(--win_hilight) !important;
    border-bottom: 2px solid var(--win_hilight) !important;
}

/* --- 録画ボタン --- */
#recordButton {
    background-color: var(--win_bg);
    color: #0A246A !important; /* クラシック濃紺文字 */
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    border-radius: 0px;
    font-weight: bold;
    font-size: 13px;
    padding: 5px 12px;
}

#recordButton:hover {
    background-color: #E0DCD4;
}

#recordButton:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
    padding: 6px 11px 4px 13px;
}

/* 録画中 (押し込み状態 + 赤文字) */
#recordButton:!hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#recordButton.state-active,
#recordButton:checked,
#recordButton:hover:checked {
    background-color: #D8D4CC !important;
    color: #C00000 !important;
    border-top: 2px solid var(--win_darkshadow) !important;
    border-left: 2px solid var(--win_darkshadow) !important;
    border-right: 2px solid var(--win_hilight) !important;
    border-bottom: 2px solid var(--win_hilight) !important;
}

/* 仮想カメラ・リプレイバッファ・スタジオモード・設定・終了 */
#replayBufferButton,
#vcamButton,
#modeSwitch,
#settingsButton,
#exitButton {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    border-radius: 0px;
    color: #000000;
}

#replayBufferButton:hover,
#vcamButton:hover,
#modeSwitch:hover,
#settingsButton:hover,
#exitButton:hover {
    background-color: #E0DCD4;
}

#replayBufferButton:pressed,
#vcamButton:pressed,
#modeSwitch:pressed,
#settingsButton:pressed,
#exitButton:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
    padding: 4px 7px 2px 9px;
}

/* =========================================================================
   9. ミキサー & スライダー (Classic 3D ノブ & スライダー)
   ========================================================================= */

/* 水平スライダー溝 (Sunken 彫り込み溝) */
QSlider::groove:horizontal {
    background-color: #FFFFFF;
    border-top: 1px solid var(--win_shadow);
    border-left: 1px solid var(--win_shadow);
    border-right: 1px solid var(--win_hilight);
    border-bottom: 1px solid var(--win_hilight);
    height: 4px;
    border-radius: 0px;
}

QSlider::sub-page:horizontal {
    background-color: var(--win_selection) !important;
}

QSlider::add-page:horizontal {
    background-color: #FFFFFF !important;
}

/* つまみ (Windows Classic スライダーノブ: ホームベース型SVG + 立体ベベル保護) */
QSlider::handle:horizontal {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    width: 11px;
    height: 20px;
    margin: -8px 0;
    image: url(theme:classic/slider_h.svg);
}

QSlider::handle:horizontal:hover {
    background-color: #E0DCD4;
}

QSlider::handle:horizontal:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
}

/* 垂直スライダー */
QSlider::groove:vertical {
    background-color: #FFFFFF;
    border-top: 1px solid var(--win_shadow);
    border-left: 1px solid var(--win_shadow);
    border-right: 1px solid var(--win_hilight);
    border-bottom: 1px solid var(--win_hilight);
    width: 4px;
    border-radius: 0px;
}

QSlider::add-page:vertical {
    background-color: var(--win_selection) !important;
}

QSlider::sub-page:vertical {
    background-color: #FFFFFF !important;
}

QSlider::handle:vertical {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    width: 20px;
    height: 11px;
    margin: 0 -8px;
    image: url(theme:classic/slider_v.svg);
}

QSlider::handle:vertical:hover {
    background-color: #E0DCD4;
}

QSlider::handle:vertical:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
}

/* 水平ミキサーのチャンネル間余白と境界線 */
#hVolumeWidgets VolumeControl {
    padding: 4px 6px 8px 6px;
    border-bottom: 1px solid var(--win_shadow);
}

#vVolumeWidgets VolumeControl {
    padding: 6px 4px;
    border-right: 1px solid var(--win_shadow);
}

VolumeControl,
VolumeControl QLabel,
VolumeControl QLabel#nameLabel,
VolumeControl QLabel#volLabel {
    color: #000000 !important;
}

VolumeControl QLabel#volLabel {
    font-size: 10px;
}

VolumeControl .mixer-category {
    color: #FFFFFF !important;
    background-color: var(--win_selection) !important;
    border-radius: 0px;
    padding: 1px 4px;
    font-weight: bold;
}

/* ミュートボタン (.btn-mute) & モニターボタン (.btn-monitor) の完全ブレ防止定義 */
.btn-mute,
.btn-monitor,
VolumeControl .btn-mute,
VolumeControl .btn-monitor {
    width: 22px;
    height: 20px;
    min-width: 22px;
    max-width: 22px;
    min-height: 20px;
    max-height: 20px;
    padding: 0px !important;
    margin: 1px 2px !important;
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_hilight) !important;
    border-left: 1px solid var(--win_hilight) !important;
    border-right: 1px solid var(--win_darkshadow) !important;
    border-bottom: 1px solid var(--win_darkshadow) !important;
    border-radius: 0px;
}

/* ホバー時 (サイズ・マージン・ボーダー幅完全固定でリフロー防止) */
.btn-mute:hover,
.btn-monitor:hover,
VolumeControl .btn-mute:hover,
VolumeControl .btn-monitor:hover {
    background-color: #E4E0D8 !important;
    border-top: 1px solid var(--win_hilight) !important;
    border-left: 1px solid var(--win_hilight) !important;
    border-right: 1px solid var(--win_darkshadow) !important;
    border-bottom: 1px solid var(--win_darkshadow) !important;
    padding: 0px !important;
    margin: 1px 2px !important;
}

/* チェック中 (ミュート中・モニター中: 凹みベベル) */
.btn-mute:checked,
.btn-monitor:checked,
.btn-mute.checked,
.btn-monitor.checked,
VolumeControl .btn-mute:checked,
VolumeControl .btn-monitor:checked {
    background-color: #D8D4CC !important;
    border-top: 1px solid var(--win_darkshadow) !important;
    border-left: 1px solid var(--win_darkshadow) !important;
    border-right: 1px solid var(--win_hilight) !important;
    border-bottom: 1px solid var(--win_hilight) !important;
    padding: 0px !important;
    margin: 1px 2px !important;
}

/* チェック中ホバー (サイズ完全不変) */
.btn-mute:checked:hover,
.btn-monitor:checked:hover,
.btn-mute.checked.hover,
.btn-monitor.checked.hover,
VolumeControl .btn-mute:checked:hover,
VolumeControl .btn-monitor:checked:hover {
    background-color: #CEC8BE !important;
    border-top: 1px solid var(--win_darkshadow) !important;
    border-left: 1px solid var(--win_darkshadow) !important;
    border-right: 1px solid var(--win_hilight) !important;
    border-bottom: 1px solid var(--win_hilight) !important;
    padding: 0px !important;
    margin: 1px 2px !important;
}

/* 押下時 (Pressed) */
.btn-mute:pressed,
.btn-monitor:pressed,
VolumeControl .btn-mute:pressed,
VolumeControl .btn-monitor:pressed {
    background-color: #C8C4BC !important;
    border-top: 1px solid var(--win_darkshadow) !important;
    border-left: 1px solid var(--win_darkshadow) !important;
    border-right: 1px solid var(--win_hilight) !important;
    border-bottom: 1px solid var(--win_hilight) !important;
    padding: 0px !important;
    margin: 1px 2px !important;
}

/* ボリュームメーター (クラシック高彩度バー) */
VolumeMeter {
    qproperty-backgroundNominalColor: #00B000;
    qproperty-backgroundWarningColor: #D0A000;
    qproperty-backgroundErrorColor:   #D00000;
    qproperty-foregroundNominalColor: #008000;
    qproperty-foregroundWarningColor: #907000;
    qproperty-foregroundErrorColor:   #900000;
}

/* =========================================================================
   10. ステータスバー & スクロールバー (Classic 3D スタイル)
   ========================================================================= */
OBSBasicStatusBar,
OBSBasicStatusBar *,
StatusBarWidget,
StatusBarWidget *,
StatusBarWidget QLabel,
StatusBarWidget QLabel#message,
QStatusBar,
QStatusBar QLabel,
QStatusBar::item {
    color: #000000 !important;
}

QStatusBar {
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_shadow);
    color: #000000;
}

QStatusBar::item {
    border-top: 1px solid var(--win_shadow);
    border-left: 1px solid var(--win_shadow);
    border-right: 1px solid var(--win_hilight);
    border-bottom: 1px solid var(--win_hilight);
}

/* --- Windows Classic のスクロールバー (16px) --- */
QScrollBar:vertical,
#previewYScrollBar,
OBSBasicSettings QScrollBar:vertical,
OBSDock QScrollBar:vertical {
    background-color: #D4D0C8;
    width: 16px !important;
    border: none !important;
    margin: 16px 0px 16px 0px !important;
}

QScrollBar:horizontal,
#previewXScrollBar,
OBSBasicSettings QScrollBar:horizontal,
OBSDock QScrollBar:horizontal {
    background-color: #D4D0C8;
    height: 16px !important;
    border: none !important;
    margin: 0px 16px 0px 16px !important;
}

/* スクロール不要時 (無効時) のレール背景 */
QScrollBar:vertical:disabled,
QScrollBar:horizontal:disabled {
    background-color: #D4D0C8;
    border: none !important;
}

/* つまみ (四角い 3D Raised ベベルボタン) */
QScrollBar::handle:vertical,
#previewYScrollBar::handle,
OBSBasicSettings QScrollBar::handle:vertical,
OBSDock QScrollBar::handle:vertical {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    min-height: 20px;
    margin: 0px !important;
    border-radius: 0px;
}

QScrollBar::handle:vertical:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
}

QScrollBar::handle:horizontal,
#previewXScrollBar::handle,
OBSBasicSettings QScrollBar::handle:horizontal,
OBSDock QScrollBar::handle:horizontal {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    min-width: 20px;
    margin: 0px !important;
    border-radius: 0px;
}

QScrollBar::handle:horizontal:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
}

/* ボタン (3D Raised ベベルボタン) */
QScrollBar::add-line:vertical {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:pressed,
QScrollBar::sub-line:vertical:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
}

QScrollBar::add-line:vertical:disabled,
QScrollBar::sub-line:vertical:disabled {
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_shadow);
    border-bottom: 1px solid var(--win_shadow);
    width: 16px !important;
    height: 16px !important;
}

QScrollBar::add-line:horizontal {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    background-color: var(--win_bg);
    border-top: 2px solid var(--win_hilight);
    border-left: 2px solid var(--win_hilight);
    border-right: 2px solid var(--win_darkshadow);
    border-bottom: 2px solid var(--win_darkshadow);
    width: 16px !important;
    height: 16px !important;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:pressed,
QScrollBar::sub-line:horizontal:pressed {
    border-top: 2px solid var(--win_darkshadow);
    border-left: 2px solid var(--win_darkshadow);
    border-right: 2px solid var(--win_hilight);
    border-bottom: 2px solid var(--win_hilight);
}

QScrollBar::add-line:horizontal:disabled,
QScrollBar::sub-line:horizontal:disabled {
    background-color: var(--win_bg);
    border-top: 1px solid var(--win_hilight);
    border-left: 1px solid var(--win_hilight);
    border-right: 1px solid var(--win_shadow);
    border-bottom: 1px solid var(--win_shadow);
    width: 16px !important;
    height: 16px !important;
}

/* 矢印アイコン (Windows Classic: クラシック三角矢印) */
QScrollBar::up-arrow:vertical {
    image: url(theme:classic/up.svg);
    width: 8px;
    height: 8px;
}
QScrollBar::up-arrow:vertical:disabled {
    image: url(theme:classic/up_disabled.svg);
    width: 8px;
    height: 8px;
}

QScrollBar::down-arrow:vertical {
    image: url(theme:classic/down.svg);
    width: 8px;
    height: 8px;
}
QScrollBar::down-arrow:vertical:disabled {
    image: url(theme:classic/down_disabled.svg);
    width: 8px;
    height: 8px;
}

QScrollBar::left-arrow:horizontal {
    image: url(theme:classic/left.svg);
    width: 8px;
    height: 8px;
}
QScrollBar::left-arrow:horizontal:disabled {
    image: url(theme:classic/left_disabled.svg);
    width: 8px;
    height: 8px;
}

QScrollBar::right-arrow:horizontal {
    image: url(theme:classic/right.svg);
    width: 8px;
    height: 8px;
}
QScrollBar::right-arrow:horizontal:disabled {
    image: url(theme:classic/right_disabled.svg);
    width: 8px;
    height: 8px;
}

/* =============================================================================
   ミキサー ミュート/モニター ボタン: ON/OFF 状態の明示分離（視認性強化）
   OFF: 透明背景 + 通常アイコン / ON: 赤(ミュート)・緑(モニター)背景 + 白アイコン
   ============================================================================= */
QPushButton.btn-mute:!checked,.btn-mute:!checked:!hover,
VolumeControl .btn-mute:!checked:!hover {
    color: #1a1a1a !important;
    background: transparent !important;
    border: 1px solid transparent !important;
    qproperty-icon: url(theme:Light/settings/audio.svg) !important;
}
QPushButton.btn-monitor:!checked,.btn-monitor:!checked:!hover,
VolumeControl .btn-monitor:!checked:!hover {
    color: #1a1a1a !important;
    background: transparent !important;
    border: 1px solid #808080 !important;
    qproperty-icon: url(theme:Light/headphones-off.svg) !important;
}
QPushButton.btn-mute:checked, QPushButton.btn-mute.checked, .btn-mute:checked, .btn-mute.checked,
VolumeControl .btn-mute:checked {
    color: #ffffff !important;
    background: #C81E1E !important;
    border: 1px solid #600000 !important;
    qproperty-icon: url(theme:Dark/mute.svg) !important;
}
QPushButton.btn-monitor:checked, QPushButton.btn-monitor.checked, .btn-monitor:checked, .btn-monitor.checked,
VolumeControl .btn-monitor:checked {
    color: #ffffff !important;
    background: #1E8C1E !important;
    border: 1px solid #004000 !important;
    qproperty-icon: url(theme:Dark/headphones.svg) !important;
}
